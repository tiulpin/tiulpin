#!/bin/sh
set -eu
if ! command -v go >/dev/null 2>&1; then
    for prefix in /opt/homebrew /usr/local; do
        if [ -x "$prefix/bin/go" ]; then
            PATH="$prefix/bin:$PATH"
            export PATH
            break
        fi
    done
fi
if ! command -v go >/dev/null 2>&1; then
    echo 'Install Go first: brew install go yadm' >&2
    exit 1
fi
exec go -C "$HOME/.config/yadm/setup" run . macos "$@"
